# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. BriefMatcher, metadata analysis).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# APP_URL: The URL where the app is hosted, used for self-referential links and OAuth callbacks.
APP_URL="http://localhost:3000"

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# 3rd Party Integrations
# Configured via Admin Dashboard Integrations tab, or set here:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
TUNEREGISTRY_API_KEY=

# Email Service (Resend)
RESEND_API_KEY=

# Cron / Automation
CRON_ENABLED=true

# E2E Test Credentials (optional — tests skip if unset)
# Create test accounts in Supabase Auth for these
TEST_ARTIST_EMAIL=
TEST_ARTIST_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
