# Production Environment Variables
# Copy this to `.env` (local) or configure as secrets in your hosting platform.
# NEVER commit a real `.env` file.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://app.ncsound.example.com
PORT=3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public (sent to browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Service-level admin access. Used in `X-API-Key` header as a bypass for
# Supabase JWT in admin scripts / cron jobs. Rotate quarterly.
ADMIN_API_KEY=

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ncsound.example.com

# ── Optional: Observability ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Optional: Logging ────────────────────────────────────────────────────────
# LOG_LEVEL=info   # trace|debug|info|warn|error
# NODE_ENV=production  (sets pino to JSON output)

# ── Optional: E2E / Load testing ─────────────────────────────────────────────
# TEST_URL=https://staging.ncsound.example.com